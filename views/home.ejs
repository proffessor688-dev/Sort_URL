<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>URL Shortener</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      padding: 50px;
      text-align: center;
    }
    h1 {
      font-size: 36px;
      color: #333;
    }
    input[type="text"] {
      padding: 10px;
      width: 300px;
      font-size: 16px;
      margin-right: 10px;
    }
    button {
      padding: 10px 20px;
      font-size: 16px;
      cursor: pointer;
    }
    form {
      margin-top: 20px;
    }
  </style>
</head>
<body>
  <!-- App Heading -->
  <h1>URL Shortener</h1>

  <!-- Form to take input -->
  <form action="/url" method="POST">
    <input type="text" name="url" placeholder="Enter your URL here" required>
    <button type="submit">Shorten URL</button>
  </form>
</body>
</html>
